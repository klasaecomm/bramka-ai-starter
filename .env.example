# Bramka AI — ustawienia. Skopiuj do .env albo uruchom ./przygotuj.sh (wygeneruje sekrety).
# Pliku .env nie commituj i nie wysyłaj nikomu.

# --- Adresy, pod którymi Ty i Twoje aplikacje widzicie usługi ---------------
# Lokalnie zostaw domyślne. Na serwerze z HTTPS: docs/vps.md.
PANEL_ADRES=http://localhost:8080
BRAMKA_ADRES=http://localhost:8317
MCP_ADRES=http://localhost:4788
# 127.0.0.1 = tylko ten komputer. Nie zmieniaj na 0.0.0.0 bez HTTPS (docs/vps.md).
ADRES_NASLUCHU=127.0.0.1
PANEL_PORT=8080
BRAMKA_PORT=8317
MCP_PORT=4788

# --- Wygląd i dane firmy -----------------------------------------------------
PANEL_NAZWA=agents
FIRMA=Moja firma
FIRMA_SLUG=firma
TZ=Europe/Warsaw
# auto = dane przykładowe, dopóki nie podłączysz pierwszego konta / MCP; 1 = zawsze; 0 = nigdy
DEMO=auto

# --- Sekrety (./przygotuj.sh wpisze losowe wartości) -------------------------
# Hasło do panelu
PANEL_HASLO=
# Podpis sesji panelu
PANEL_SESJA=
# Klucz zarządzania bramką (używa go tylko panel)
KLUCZ_ZARZADZANIA=
# Tokeny dostępu do bramki: po przecinku, osobny dla każdej osoby / komputera
TOKENY_DOSTEPU=
# Konto administratora Executora (MCP); e-mail może być dowolny, służy do logowania
ADMIN_NAZWA=Administrator
ADMIN_EMAIL=admin@bramka.local
ADMIN_HASLO=
# Szyfrowanie tokenów MCP w bazie Executora — nie zmieniaj po pierwszym starcie
EXECUTOR_SECRET_KEY=
EXECUTOR_SESJA=

# --- Tylko serwer z HTTPS (docker-compose.vps.yml, docs/vps.md) --------------
# DOMENA_PANELU=ai.firma.pl
# DOMENA_MCP=mcp.firma.pl
# EMAIL_TLS=admin@firma.pl
